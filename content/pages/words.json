      "blocks": [
        {
          "id": "blk_6adz512k48",
          "type": "component/sp-words-52",
          "v": 1,
          "fields": {
            "t1": "★ A few terms, plainly",
            "t2": "Begin with",
            "t3": "the words.",
            "t4": "A few words come up often on this site. Here",
            "t5": "'",
            "t6": "s the short version of each. Hover any",
            "t7": "underlined",
            "t8": "word elsewhere on the site for an inline definition.",
            "g1": [
              {
                "t1": "01",
                "t2": "Bioregion",
                "t3": "noun",
                "t4": "A geographically and hydrologically defined area characterized by distinct ecological features that together form a coherent biocultural home.",
                "t5": "02",
                "t6": "The Commons",
                "t7": "noun",
                "t8": "\"",
                "t9": "The Commons",
                "t10": "\"",
                "t11": "points to the living realities of shared place — the commonality of the ecologies and resources for which all residents of a place share responsibility, and on which all residents depend.",
                "t12": "03",
                "t13": "The Front Range Commons",
                "t14": "noun",
                "t15": "A decentralized, member-directed network-in-formation dedicated to cultural and ecological stewardship, and community-led resource allocation; a space where anyone can contribute, propose projects, share resources, and participate in network governance.",
                "t16": "04",
                "t17": "Commoning",
                "t18": "verb",
                "t19": "Commoning on a bioregional level directs our attentions and energies to where we can directly relate to the consequences of our stewardship, labor, and care.",
                "t20": "05",
                "t21": "Bioregional Commoning",
                "t22": "verb",
                "t23": "Recognizes the wellbeing of human and natural systems (neighborhoods, watersheds, ecosystems, soil) as",
                "t24": "shared resources",
                "t25": "that the people who live in and depend on that land take responsibility to",
                "t26": "steward",
                "t27": "collectively.",
                "t28": "06",
                "t29": "Resilience",
                "t30": "noun",
                "t31": "The capacity of a community to absorb shocks — storms, outages, economic disruption, supply chain failure — and recover together. Not bunkers, but networks.",
                "t32": "07",
                "t33": "The Lattice",
                "t34": "noun",
                "t35": "SPIRIT",
                "t36": "'",
                "t37": "s operating metaphor. The minimum infrastructure that enables Commons activity without controlling it.",
                "t38": "08",
                "t39": "Institutional Self-Negation",
                "t40": "noun",
                "t41": "The deliberate practice of transferring responsibility from SPIRIT to the Commons as fast as the Commons can absorb it.",
                "t42": "09",
                "t43": "Regeneration",
                "t44": "noun",
                "t45": "Regeneration means renewing the capacity to renew. Consider the old adage about teaching someone to fish, rather than giving them a fish. Regeneration is about teaching them how to fish, how to make their own fishing poles, how to keep the fish in the pond happily reproducing. Cultural regeneration would teach them how to prepare the fish and share the meal with their relatives."
              }
            ],
            "t9": "— 04.5 —"
          }
        }
      ]
