          "id": "blk_g8vdpv3ht9",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "★ about this collection"
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 2
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "We publish slowly, and we publish what matters."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "This is not content marketing. It's a small, carefully tended library of the writing behind this work — essays on caring for place, talks on the moment we're in, working papers on how communities make decisions together, and notes from the Front Range itself."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Many of these pieces live on the writers' own sites — we link out and trust you to follow. Some live here, where we can edit, footnote, and add to them over time. "
                    },
                    {
                      "type": "text",
                      "text": "All of them are offered as context — so the work we do on the ground reads in its larger frame.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "— 04.1 —"
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    },
