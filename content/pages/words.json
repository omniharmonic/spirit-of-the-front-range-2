          "fields": {
            "t1": "Also in the library",
            "t2": "Further",
            "t3": "reading.",
            "t4": "paper · January 2026",
            "t5": "OpenCivics Labs",
            "l1": {
              "type": "url",
              "url": "https://opencivics.co/labs/bioregioning",
              "newTab": true
            },
            "t6": "Bioregional Coordination: A Hybrid Framework for Network Commons",
            "t7": "A long-form working paper laying out the two-body model behind SPIRIT",
            "t8": "'",
            "t9": "s design: a small nonprofit that handles the legal and financial work, paired with a larger community body that holds the actual decision-making. Includes Elinor Ostrom",
            "t10": "'",
            "t11": "s principles for shared resource management and a practical plan for how to build something like this.",
            "l2": {
              "type": "url",
              "url": "https://opencivics.co/labs/bioregioning",
              "newTab": true
            },
            "t12": "↗ Read external",
            "t13": "essay · November 2025",
            "t14": "omniharmonic",
            "l3": {
              "type": "url",
              "url": "https://omniharmonic.substack.com",
              "newTab": true
            },
            "t15": "Collapse, Parallel Societies, and the Bioregional Imperative",
            "t16": "On the slow unraveling of public institutions and why community-led, place-based networks — building real alternatives alongside the systems we still depend on — offer a third path between individual retreat and ideological exit.",
            "l4": {
              "type": "url",
              "url": "https://omniharmonic.substack.com",
              "newTab": true
            },
            "t17": "↗ Read external",
            "t18": "— 04.3 —"
          }
        }
      ]
    },
