      "blocks": [
        {
          "id": "blk_wn41bv7rtm",
          "type": "quote",
          "v": 1,
          "fields": {
            "quote": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Our relationship to where we live carries with it a responsibility for that place. That responsibility belongs to all of us — it isn't something anyone can own or fence off. It is, by its nature, a commons."
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
