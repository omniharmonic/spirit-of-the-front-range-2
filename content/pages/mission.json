    {
      "id": "sec_ydzb906qet",
      "preset": "starter/stack-6-6@1",
      "layout": {
        "mode": "stack",
        "columns": {
          "d": [
            5,
            7
          ],
          "m": [
            12
          ]
        },
        "align": "center"
      },
      "style": {
