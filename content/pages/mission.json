      "blocks": [
        {
          "id": "blk_jw93x1ay2h",
          "type": "component/sp-mission-16",
          "v": 1,
          "fields": {
            "t1": "\"",
            "t2": "Our relationship to where we live carries with it a responsibility for that place. That responsibility belongs to all of us — it isn't something anyone can own or fence off. It is, by its nature, a commons.",
            "t3": "— Benjamin Life"
          }
        }
      ]
    },
