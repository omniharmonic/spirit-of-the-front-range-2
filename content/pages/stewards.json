              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Meet the team"
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 2
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "The current Transitional Stewards"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "6 people · As of Oct 2026"
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "sec_yfzxjme2hd",
      "preset": "starter/stack-3-3-3-3@1",
      "layout": {
        "mode": "stack",
