    {
      "id": "sec_s8je4g62yc",
      "preset": "component/sp-catalog-41@1",
      "label": "Governing the Commons ↗",
      "layout": {
        "mode": "stack",
        "columns": {
          "d": [
            12
          ]
        },
        "width": "full"
      },
      "style": {
        "padding": {
          "d": "none",
          "m": "none"
        },
        "background": {
          "type": "color",
          "color": "#F2EAD8"
        }
      },
      "blocks": [
        {
          "id": "blk_s8je4g62yc",
          "type": "component/sp-catalog-41",
          "v": 1,
          "fields": {
            "t1": "N° 01",
            "t2": "How this works.",
            "t3": "Each entry has someone from our team behind it who vouches for it personally. We don",
            "t4": "'",
            "t5": "t aggregate. We recommend.",
            "t6": "Want to suggest an addition?",
            "l1": {
              "type": "page",
              "page": "pg_7nbz8t2ex4"
            },
            "t7": "Write to us",
            "t8": ". We add slowly, by consensus.",
            "t9": "★ Items in this issue:",
            "t10": "9",
            "t11": ".",
            "g1": [
              {
                "t1": "N° 1",
                "t2": "book",
                "l1": {
                  "type": "url",
                  "url": "https://www.cambridge.org/core/books/governing-the-commons/A8BB63BC4A1433A50A3FB92EDBBB97D5",
                  "newTab": true
                },
                "t3": "Governing the Commons",
                "t4": "↗",
                "t5": "The book that won Ostrom the Nobel and dismantled Hardin’s “Tragedy of the Commons.” Eight design principles for how communities actually steward shared resources together — without private enclosure or state takeover. Foundational reading for anyone serious about commoning at any scale.",
                "t6": "— Curated by",
                "t7": "Benjamin Life",
                "t8": "Cambridge University Press · 1990",
                "t9": "$28",
                "t10": "N° 2",
                "t11": "book",
                "l2": {
                  "type": "url",
                  "url": "https://milkweed.org/book/braiding-sweetgrass",
                  "newTab": true
                },
                "t12": "Braiding Sweetgrass",
                "t13": "↗",
                "t14": "Indigenous wisdom, scientific knowledge, and the teachings of plants — woven together. Kimmerer (citizen of the Citizen Potawatomi Nation, professor of botany) writes the bioregional ethic better than most policy papers manage. If you read one book on what",
                "t15": "belonging",
                "t16": "means in a place, this is it.",
                "t17": "— Curated by",
                "t18": "Kathleen Marie Rose",
                "t19": "Milkweed Editions · 2013",
                "t20": "$20",
                "t21": "N° 3",
                "t22": "organization",
                "l3": {
                  "type": "url",
                  "url": "https://www.frontrangecommons.org/",
                  "newTab": true
                },
                "t23": "Front Range Commons",
                "t24": "↗",
                "t25": "The parallel, member-led civic body SPIRIT feeds and protects but does not control. Commoners elect a Wisdom Council, which appoints Common Stewards. Where the day-to-day work of caring for the Front Range will live. Founding membership is opening — see",
                "t26": "Connect.",
                "t27": "— Curated by",
                "t28": "SPIRIT",
                "t29": "frontrangecommons.org",
                "t30": "N° 4",
                "t31": "book",
                "l4": {
                  "type": "url",
                  "url": "https://www.jeremylent.com/the-patterning-instinct.html",
                  "newTab": true
                },
                "t32": "The Patterning Instinct",
                "t33": "↗",
                "t34": "A cultural history of how worldviews shape civilizations — and why the dominant Western metaphor of “nature as machine” is at the root of our ecological crisis. Useful for understanding why the Commons isn’t a policy proposal; it’s a cosmology shift.",
                "t35": "— Curated by",
                "t36": "Benjamin Life",
                "t37": "Prometheus Books · 2017",
                "t38": "$25",
                "t39": "N° 5",
                "t40": "tool",
                "l5": {
                  "type": "url",
                  "url": "https://www.radicalxchange.org/concepts/quadratic-funding/",
                  "newTab": true
                },
                "t41": "Quadratic Funding",
                "t42": "↗",
                "t43": "The mathematical mechanism behind the Front Range Commons’ planned grant rounds: the matching pool amplifies the",
                "t44": "number",
                "t45": "of contributors, not the size of contributions. A wealthy donor’s $10,000 funds less than 100 neighbors each giving $5. Designed for genuine pluralism in resource allocation.",
                "t46": "— Curated by",
                "t47": "Cameron Ely-Murdock",
                "t48": "Liberal Radicalism · 2018",
                "t49": "Open",
                "t50": "N° 6",
                "t51": "organization",
                "l6": {
                  "type": "url",
                  "url": "https://www.sociocracyforall.org/",
                  "newTab": true
                },
                "t52": "Sociocracy For All",
                "t53": "↗",
                "t54": "The cleanest current resource for sociocratic decision-making. SPIRIT operates by",
                "t55": "consent",
                "t56": "(not majority vote) inside the Stewardship Council, with circle-level autonomy — patterns SfA documents and trains. If you want to bring sociocracy into your own organization, start here.",
                "t57": "— Curated by",
                "t58": "Jordan Siegel",
                "t59": "sociocracyforall.org",
                "t60": "Donation",
                "t61": "N° 7",
                "t62": "practice",
                "t63": "The Listeners",
                "t64": "'",
                "t65": "Council",
                "t66": "A specific gathering form: one person speaks at a time, holding a token; others listen without preparing a response. No cross-talk, no debate. The form draws from many lineages — Indigenous councils, Quaker meetings, the Way of Council. We use it at Solidarity Suppers when the conversation matters enough.",
                "t67": "— Curated by",
                "t68": "Sarah D",
                "t69": "'",
                "t70": "Antoni",
                "t71": "Practiced at Solidarity Suppers",
                "t72": "N° 8",
                "t73": "place",
                "l7": {
                  "type": "url",
                  "url": "https://bouldercolorado.gov/services/open-space-and-mountain-parks",
                  "newTab": true
                },
                "t74": "The Flatirons",
                "t75": "↗",
                "t76": "The slanted sandstone slabs above Boulder — 290 million-year-old conglomerate from the Fountain Formation, lifted and tilted during the Laramide Orogeny. The signature backdrop of the Front Range and the geologic punctuation that says",
                "t77": "here.",
                "t78": "Walk Chautauqua at dawn.",
                "t79": "— Curated by",
                "t80": "SPIRIT",
                "t81": "Boulder Open Space",
                "t82": "&",
                "t83": "Mountain Parks",
                "t84": "Free",
                "t85": "N° 9",
                "t86": "place",
                "l8": {
                  "type": "url",
                  "url": "https://www.fs.usda.gov/recarea/arp/recarea/?recid=36504",
                  "newTab": true
                },
                "t87": "Cache la Poudre River",
                "t88": "↗",
                "t89": "Colorado’s only nationally designated Wild",
                "t90": "&",
                "t91": "Scenic River. Headwaters in Rocky Mountain National Park; flows through Fort Collins on its way to the South Platte. The watershed that holds the northern reach of our bioregion and grounds the work of regional water stewardship coalitions.",
                "t92": "— Curated by",
                "t93": "SPIRIT",
                "t94": "Northern Front Range watershed",
                "t95": "Free"
              }
            ],
            "t12": "✦ end of the list — more next time ✦",
            "t13": "— 05.1 —"
          }
        }
      ]
    }
  ]
