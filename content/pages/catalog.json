          "fields": {
            "text1": "RECOMMENDATIONS FROM THE TEAM · UPDATED AS WE GO",
            "text2": "A small reading list.",
            "text3": "A working list of the books, organizations, tools, places, and practices that have shaped our work — and might shape yours. In the spirit of Stewart Brand's old Whole Earth Catalog: an entry only makes it in if it is genuinely useful, in print, and not already common knowledge.",
            "label4": "TRUE TO ESSENCE",
            "link4": {
              "type": "url",
              "url": "https://www.truetoessence.com/"
            }
          }
        }
