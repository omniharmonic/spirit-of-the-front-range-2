          "type": "component/imported-connect-2",
          "v": 1,
          "fields": {
            "text1": "STAY CONNECTED",
            "text2": "THE MAIN WAY IN",
            "text3": "Subscribe for what matters to you.",
            "text4": "One place for events, program openings, and interest in the Commons — handled on our community dashboard.",
            "label5": "✦ SUBSCRIBE & EXPRESS INTEREST →",
            "link5": {
              "type": "url",
              "url": "https://dashboard.spiritofthefrontrange.org/subscribe"
            },
            "text6": "Sign up to receive updates about the programs you care about — teach-ins, Solidarity Suppers, neighborhood preparedness, and grant rounds.",
            "text7": "SUBSCRIBING OPENS OUR COMMUNITY DASHBOARD IN A NEW TAB.",
            "text8": "FIND US ELSEWHERE",
            "text9": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "  ✎ Substack  Essays & field notes ",
                      "marks": [
                        {
                          "type": "link",
                          "attrs": {
                            "href": "https://spiritofthefrontrange.substack.com/"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "text10": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "You can also express interest in becoming a founding member of the "
                    },
                    {
                      "type": "text",
                      "text": "Front Range Commons",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " — the community of people deciding together how to care for this place."
                    }
                  ]
                }
              ]
            },
            "text11": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
