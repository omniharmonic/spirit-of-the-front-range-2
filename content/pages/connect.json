      "blocks": [
        {
          "id": "blk_ytrxs4pwez",
          "type": "component/imported-connect-3",
          "v": 1,
          "fields": {
            "text1": "FEELING INSPIRED? LET'S TALK.",
            "text2": "Questions. Projects. Partnerships. Knowledge. Stories. Inspiration.",
            "text3": "We would love to hear from you.",
            "text4": "COME TO SOMETHING",
            "text5": "JUST SAY HELLO",
            "text6": "See what's coming up",
            "text7": "Email us",
            "text8": "Public teach-ins, Solidarity Suppers, neighborhood preparedness sessions — open community gatherings. The fastest way to feel the work is to come to one.",
            "text9": "For questions, partnerships, or just to introduce yourself — we read every message and answer personally.",
            "label10": "ADMIN@SPIRITOFTHEFRONTRANGE.ORG",
            "link10": {
              "type": "email",
              "email": "admin@spiritofthefrontrange.org"
            },
            "label11": "◇ BROWSE THE CALENDAR →",
            "link11": {
              "type": "url",
              "url": "https://dashboard.spiritofthefrontrange.org/calendar"
            },
            "text12": "JOIN THE COMMONS",
            "text13": "SUPPORT THE WORK",
            "text14": "Become a founding member",
            "text15": "Make a tax-deductible gift",
            "text16": "If you live on the Front Range, you can join the Front Range Commons as a founding member. Propose projects, vote on community grants, and help shape what this looks like in practice.",
            "text17": "Your gift funds the programs, the community grant rounds, and the shared work of a healthy Front Range.",
            "label18": "◈ DONATE →",
            "link18": {
              "type": "page",
              "page": "pg_nx1cbdabp0"
            },
            "label19": "★ VISIT THE COMMONS →",
            "link19": {
              "type": "url",
              "url": "https://www.frontrangecommons.org/"
            }
          }
        }
      ]
