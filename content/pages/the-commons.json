      "blocks": [
        {
          "id": "blk_1zdtfwsvdw",
          "type": "text",
          "v": 1,
          "column": 0,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "What we're building toward"
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 1
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "The Front Range Commons."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "A community body — forming now — where the people who live on the Front Range can make collective decisions about how to take care of where they live. Anyone who lives here can join."
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "id": "blk_vy0dr3dpjn",
          "type": "text",
          "v": 1,
          "column": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "● The Commons photographed by "
                    },
                    {
                      "type": "text",
                      "text": "True To Essence",
                      "marks": [
                        {
                          "type": "link",
                          "attrs": {
                            "href": "https://www.truetoessence.com",
                            "newTab": true
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "sec_p0r7jjtx4b",
      "preset": "starter/stack-6-6@1",
      "layout": {
        "mode": "stack",
        "columns": {
          "d": [
            6,
            6
          ],
          "m": [
            12
          ]
        },
        "align": "center"
      },
      "style": {
        "colorTheme": "light"
      },
      "blocks": [
        {
          "id": "blk_rkzy4740pe",
          "type": "text",
          "v": 1,
          "column": 0,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The short version"
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 2
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "A way for us to take care of this place together."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "A decentralized, member-directed network-in-formation dedicated to cultural and ecological stewardship, and community-led resource allocation; a space where anyone can contribute, propose projects, share resources, and participate in network governance."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The Front Range Commonsthe front range commonsA decentralized, member-directed network-in-formation dedicated to cultural and ecological stewardship, and community-led resource allocation; a space where anyone can contribute, propose projects, share resources, and participate in network governance."
                    },
                    {
                      "type": "text",
                      "text": "Full glossary →",
                      "marks": [
                        {
                          "type": "link",
                          "attrs": {
                            "href": "/words/#glossary"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " is "
                    },
                    {
                      "type": "text",
                      "text": "a way for the people who live on the Front Range to make collective decisions about how to care for where we live.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " Anyone who lives here can join. Members can propose projects, share resources, and vote on how community-raised money gets used."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Members elect a "
                    },
                    {
                      "type": "text",
                      "text": "Wisdom Council",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " — especially elders and Indigenous neighbors — who in turn pick "
                    },
                    {
                      "type": "text",
                      "text": "Common Stewards",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " to handle the day-to-day work."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "SPIRIT is the "
                    },
                    {
                      "type": "text",
                      "text": "scaffolding",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " that makes this possible. SPIRIT handles the legal pieces and the paperwork — what a nonprofit can do that a community body cannot. "
                    },
                    {
                      "type": "text",
                      "text": "The Commonscommons“The Commons” points to the living realities of shared place — the commonality of the ecologies and resources for which all residents of a place share responsibility, and on which all residents depend.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "Full glossary →",
                      "marks": [
                        {
                          "type": "link",
                          "attrs": {
                            "href": "/words/#glossary"
                          }
                        },
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " does the actual work of caring for this place.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "id": "blk_vr2bse4qj2",
          "type": "image",
          "v": 1,
          "column": 1,
          "fields": {
            "image": {
              "src": "media/2026/10/front-range-satellite-ct6b.jpg",
              "alt": "Satellite image of the Colorado Front Range corridor, where the Rocky Mountains meet the high plains.",
              "width": 1535,
              "height": 2400,
              "mediaId": "med_ct6brvfbtn"
            },
            "aspect": "original",
            "lightbox": false,
            "caption": "fig. 1 · the corridor satellite · the Front Range"
          }
        },
        {
          "id": "blk_5bc44mv3bf",
          "type": "text",
          "v": 1,
          "column": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "SPIRIT is a 501(c)(3) nonprofit that exists to serve the Commons, and not to perpetuate itself. SPIRIT is the vessel that interfaces with the existing world of foundations, governments, and formal partnerships to offer programming, education, and fiscal sponsorship to serve the regeneration of the Front Range. We are a Transitional Stewardship team designing the SPIRIT institution to be replaced by the decentralized, member-directed Commons."
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    },
