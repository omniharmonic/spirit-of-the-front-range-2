          "v": 1,
          "column": 0,
          "fields": {
            "text": "Four Pillars, woven together.",
            "level": "h2",
            "size": "auto",
            "eyebrow": "Four threads, four pillars"
          },
          "variant": "plain"
        },
        {
          "id": "blk_fx0357m54h",
          "type": "text",
          "v": 1,
          "column": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "SPIRIT exists to coordinate a decentralized movement of local leaders engaged in economic re-localization, Indigenous revitalization, neighborhood resiliency, and bioregional regeneration. Our four pillars guide us toward alignment with that purpose."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "↑ see Programs above for what these look like in practice"
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "sec_33ny90kdw3",
      "preset": "starter/stack-12@1",
      "layout": {
        "mode": "stack",
        "columns": {
          "d": [
            12
          ]
        }
      },
      "style": {
