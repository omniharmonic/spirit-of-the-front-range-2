    {
      "id": "sec_jjd58ydsw9",
      "preset": "component/imported-home-5@1",
      "label": "SPIRIT was formed in response to the…",
      "anchor": "why",
      "layout": {
        "mode": "stack",
        "columns": {
          "d": [
            12
          ]
        },
        "width": "wide"
