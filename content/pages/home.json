      "blocks": [
        {
          "id": "blk_sxx2mz6sh1",
          "type": "component/imported-home-7",
          "v": 1,
          "fields": {
            "text1": "SUPPORT THE WORK",
            "text2": "Every gift moves us toward a more connected Front Range.",
            "text3": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Your financial contribution supports programming, community-led allocation rounds, and the shared infrastructure that makes a flourishing bioregion possible.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "text5": "HOW YOUR DOLLAR FLOWS",
            "text6": "Supporting bioregional organizing team",
            "text7": "Every donation moves toward a more resilient, more connected Front Range — through Commons Sense Teach-Ins that open understanding, Solidarity Suppers that deepen relationships, Neighborhood Resiliency Programs that build real preparedness, and Community Grant Rounds that put resources directly in the hands of the communities doing the most vital work.",
            "text8": "Funding SPIRIT programs to seed the commons",
            "text9": "Funding the Commons Grant Pool",
            "label10": "DONATE",
            "link10": {
              "type": "page",
              "page": "pg_nx1cbdabp0"
            },
            "label11": "◇ SEE WHERE IT GOES",
