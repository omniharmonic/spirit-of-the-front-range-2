          "d": [
            12
          ]
        }
      },
      "style": {
        "colorTheme": "light"
      },
      "blocks": [
        {
          "id": "blk_r4m26zgbda",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "CGR"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Pillar · Allocation"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Community-decided grant rounds that put funds directly into the hands of the people doing the work of caring for the Front Range.",
                      "marks": [
                        {
                          "type": "italic"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Commons members propose projects that support the regeneration and resiliency of our ecologies and cultures (think: planting trees to restore the watershed, creating neighborhood microgrids, planting native pollinator gardens, offering participatory cultural events, etc.) and the larger membership of the Commons votes on which projects to fund in each round. Anyone from the Commons can propose a regenerative project to the Bioregional Flow Fund, and then the larger body of the Commons votes on which projects will receive allocations."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "This is not a boardroom deciding what’s good for our lands and the life that lives here. It is the care-hearted people of this place deciding for ourselves.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The first round is being designed now. "
                    },
                    {
                      "type": "text",
                      "text": "Sign up",
                      "marks": [
                        {
                          "type": "link",
                          "attrs": {
                            "href": "https://dashboard.spiritofthefrontrange.org/subscribe"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " to hear when applications open."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "— 06.1 —"
                    }
                  ]
                }
              ]
            }
          }
        }
      ],
      "preset": "starter/stack-12@1"
    },
