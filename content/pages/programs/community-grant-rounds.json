    {
      "id": "sec_41c5rwykyh",
      "preset": "component/sp-community-gran-62@1",
      "label": "Each program weaves with the others.",
      "layout": {
        "mode": "stack",
        "columns": {
          "d": [
            12
          ]
        },
        "width": "full"
      },
      "style": {
        "padding": {
