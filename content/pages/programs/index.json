      "blocks": [
        {
          "id": "blk_gch8hf1m27",
          "type": "component/sp-programs-20",
          "v": 1,
          "fields": {
            "i1": {
              "src": "media/2026/10/plate-teach-ins-books-duotone-sage-z0aq.jpg",
              "alt": "Commons Sense Teach-Ins"
            },
            "t1": "a glimpse of",
            "t2": "commons sense teach-ins",
            "t3": "CST",
            "t4": "Pillar · Culturing",
            "t5": "Commons Sense Teach-Ins.",
            "t6": "“What even IS the Commons?” “What does being part of the Commons mean for us?”",
            "t7": "Commons Sense is a broadcast teaching on the philosophical, historical, and practical roots of the Commons, particularly the “commons sense” that we all share responsibility for our most elemental resources – the land, the water, the air, and each other. Drawing on Elinor Ostrom’s Nobel Prize-winning research, Indigenous stewardship traditions, and the practical wisdom of communities that never stopped commoning, we educate our viewers on practical paths toward bioregional self-organizing, resiliency, and regeneration that address the Common Good.",
            "t8": "active",
            "l1": {
              "type": "page",
              "page": "pg_vprm01pyk0"
            },
            "t9": "Read more →",
            "l2": {
              "type": "url",
              "url": "https://dashboard.spiritofthefrontrange.org/subscribe",
              "newTab": true
            },
            "t10": "✉ Get on the list",
            "t11": "— 06.1 —"
          }
        }
      ]
