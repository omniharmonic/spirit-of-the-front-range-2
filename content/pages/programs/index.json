            "i1": {
              "src": "media/2026/10/plate-grant-rounds-garden-duotone-sage-xddp.jpg",
              "alt": "Community Grant Rounds"
            },
            "t1": "a glimpse of",
            "t2": "community grant rounds",
            "t3": "CGR",
            "t4": "Pillar · Allocation",
            "t5": "Community Grant Rounds.",
            "t6": "Community-decided grant rounds that put funds directly into the hands of the people doing the work of caring for the Front Range.",
            "t7": "Commons members propose projects that support the regeneration and resiliency of our ecologies and cultures (think: planting trees to restore the watershed, creating neighborhood microgrids, planting native pollinator gardens, offering participatory cultural events, etc.) and the larger membership of the Commons votes on which projects to fund in each round. Anyone from the Commons can propose a regenerative project to the Bioregional Flow Fund, and then the larger body of the Commons votes on which projects will receive allocations.",
            "t8": "This is not a boardroom deciding what’s good for our lands and the life that lives here. It is the care-hearted people of this place deciding for ourselves.",
            "t9": "The first round is being designed now.",
            "l1": {
              "type": "url",
              "url": "https://dashboard.spiritofthefrontrange.org/subscribe"
            },
            "t10": "Sign up",
            "t11": "to hear when applications open.",
            "t12": "upcoming",
            "l2": {
              "type": "page",
              "page": "pg_fns9mfhdtt"
            },
            "t13": "Read more →",
            "l3": {
              "type": "url",
              "url": "https://dashboard.spiritofthefrontrange.org/subscribe",
              "newTab": true
            },
            "t14": "✉ Get on the list",
            "t15": "— 06.4 —"
          }
        }
